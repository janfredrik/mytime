# Kopier til .env og fyll inn verdiene.

# Offentlig adresse (brukes til redirect-URI og sikre cookies)
PUBLIC_URL=https://mytime.x99.no

# Microsoft Entra ID – App registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Tilfeldig hemmelighet for signering av cookies (minst 32 tegn): openssl rand -hex 32
SESSION_SECRET=

# Databasepassord (bruk kun bokstaver og tall): openssl rand -hex 24
POSTGRES_PASSWORD=

# Port på Unraid som reverse proxy peker til, og hvor databasen lagres
APP_PORT=8080
DATA_DIR=/mnt/user/appdata/mytime

# Valgfritt
# SESSION_TTL_DAYS=14
# LOG_LEVEL=info
TZ=Europe/Oslo
